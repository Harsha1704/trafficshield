# ─── TrafficShield Production Configuration Template ─────────────────────────
# Copy to .env or inject securely via environment variables / secret manager.
# NEVER commit real credentials, tokens, or private keys to version control.

# ─── Environment & Runtime ───────────────────────────────────────────────────
FLASK_APP=run.py
# Environment: 'development', 'testing', or 'production'
FLASK_ENV=production
APP_ENV=production
FLASK_DEBUG=0

# Secret key: Cryptographically secure random string (minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-strong-random-secret-key-at-least-32-chars

# ─── Database ─────────────────────────────────────────────────────────────────
# Production: Managed PostgreSQL instance (SQLite is strictly forbidden in production)
DATABASE_URL=postgresql://trafficshield_user:replace_with_secure_password@localhost:5432/trafficshield_prod
# Development only:
# DATABASE_URL=sqlite:///trafficshield_dev.db

# ─── Authentication & RBAC ────────────────────────────────────────────────────
AUTH_ENABLED=1
AUTH_TOKEN_EXPIRY_HOURS=8
# Initial bootstrap credentials (leave password empty after first initialization)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-strong-initial-admin-password
ANALYST_INITIAL_USERNAME=analyst
ANALYST_INITIAL_PASSWORD=replace-with-strong-initial-analyst-password

# ─── Redis / Cache (Optional) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Application Metadata ─────────────────────────────────────────────────────
APP_NAME=TrafficShield
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Security & Browser Policy ────────────────────────────────────────────────
# Set to 1 in production behind HTTPS reverse proxy (enforces secure cookies)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax

# ─── CORS Allowlist ───────────────────────────────────────────────────────────
# Comma-separated list of trusted origins (never use wildcard '*' in production)
CORS_ORIGINS=https://soc.trafficshield.internal,https://command.trafficshield.internal

# ─── Upload & Ingestion Limits ────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600
ALLOWED_EXTENSIONS=csv,pcap,pcapng

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATELIMIT_DEFAULT=500 per hour
RATELIMIT_STORAGE_URL=memory://

# ─── Monitoring & Retention ───────────────────────────────────────────────────
MONITORING_RETENTION_DAYS=30
MONITORING_STALE_HOURS=24

# ─── Real-Time Capture & Replay (Milestone 14) ──────────────────────────────
CAPTURE_DEFAULT_INTERFACE=
CAPTURE_FLOW_IDLE_TIMEOUT_SECONDS=2.0
CAPTURE_MAX_FLOW_LIFETIME_SECONDS=60.0
CAPTURE_MAX_ACTIVE_FLOWS=10000
CAPTURE_SPEED_MULTIPLIER=1.0
CAPTURE_DIR=data/captures
