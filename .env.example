# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-use-secrets-manager

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development default — leave blank to use SQLite)
DATABASE_URL=sqlite:///trafficshield_dev.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://trafficshield:yourpassword@localhost:5432/trafficshield

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=trafficshield

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=TrafficShield
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Upload Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600          # 100 MB
ALLOWED_EXTENSIONS=csv,pcap,pcapng

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URL=memory://

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (never use * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
# Set to 1 in production when behind HTTPS proxy
SESSION_COOKIE_SECURE=0
CSRF_ENABLED=0
